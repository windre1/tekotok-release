# ============================================
# VIRALKIT — Environment Variables
# Copy this file to .env.local and fill values
# ============================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Replicate (AI Image Generation)
# Get your key at: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_your_replicate_token

# ElevenLabs (AI Audio / TTS)
# Get your key at: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID_FEMALE=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_VOICE_ID_MALE=VR6AewLTigWG4xSOukaG

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
