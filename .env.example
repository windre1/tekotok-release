# ============================================
# VIRALKIT — Environment Variables
# Copy ke .env.local dan isi nilainya
# ============================================

# ── Supabase ─────────────────────────────────
# Dari: supabase.com → project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJ...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJ...

# ── Fal.ai (Image Generation - GRATIS $10 kredit) ───
# Daftar: fal.ai → Sign up → Dashboard → API Keys
# Klik "Create new key" → copy key (dimulai fal-xxx atau key-xxx)
FAL_API_KEY=fal-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Gemini (Audio TTS - GRATIS) ──────────────
# Dari: aistudio.google.com/app/apikey → Create API Key
# Login Google → Create API Key → copy (dimulai AIzaSy...)
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── App ───────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
